# Python artifacts
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
.venv/
venv/

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/

# Local large array caches / data (kept out of the repo)
*.npz
*.h5ad
*.parquet
data/

# Manuscript agent-team intermediates (drafts/factchecks)
agents/out/
*.env
deepseek.env

# Built manuscript PDF (reproducible via pandoc)
*.pdf
# ...but the manuscript figures ARE tracked (the paper embeds them; regenerate via
# scripts/make_manuscript_figures.py from committed fixtures).
!figures/*.pdf

# Lean / Mathlib build artifacts (multi-GB; regenerated via `lake exe cache get` + `lake build`).
# lake-manifest.json IS committed (pins the exact Mathlib revision for reproducibility).
lean/.lake/

# generated manuscript intermediates (build_manuscript.py)
build/

# Microsoft Word lock files
~$*.docx
