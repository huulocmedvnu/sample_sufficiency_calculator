%% Study overview flowchart (Mermaid.js source, for web / GitHub rendering).
%% The manuscript embeds a Graphviz render of the same design
%% (scripts/make_study_flowchart.py -> figures/fig1_study_flowchart.pdf), because the
%% pandoc/tectonic PDF build has no Mermaid renderer. Keep the two in sync by hand.
%%{init: {'theme':'base','themeVariables':{'fontFamily':'Inter, Segoe UI, Helvetica, sans-serif','fontSize':'13px','lineColor':'#64748B'},'flowchart':{'curve':'basis','nodeSpacing':45,'rankSpacing':60,'padding':10}}}%%
graph TD
    Q(["`**Core research question**
    How many cells per arm resolve a perturbation's *direction* (mechanism) to an angular tolerance θ?`"])

    TH("`**Closed-form cell quota**
    n★ = 2·tr(PΣP) / (m²θ²),  P = I − uuᵀ
    only noise ⊥ to the effect rotates the direction
    calibrated → n★ ≈ 9,376 / m²  at θ = 0.1 rad`")

    subgraph PROOF["Airtight foundation · proven four independent ways"]
        direction LR
        P1("`**Lean 4 / Mathlib**
        deterministic core, no *sorry*`")
        P2("`**SymPy**
        symbolic Jacobian`")
        P3("`**Monte-Carlo**
        < 0.13% error`")
        P4("`**Independent impl.**
        cross-check`")
    end

    PIPE{{"`**Shared embedding pipeline**
    Normalize → log1p → HVG 2000 → PCA 50
    within-condition Σ → σ²   ·   centroids → magnitude m`"}}

    subgraph EMP["Cross-Modality Empirical Validation"]
        direction LR
        subgraph CHEM["Chemical modality · Vevo Mosaic"]
            direction TB
            TA["`**Tahoe-100M · calibration anchor**
            100.6M cells · 56,827 conditions
            σ² = 0.96 → n★ = 9,376 / m²
            spectrum: 10.6% over / 89.0% under / 0.4% ghost`"]
            EB["`**EmeraldBay · out-of-distribution validation**
            1.83M cells · 52 lines
            σ² ≈ 0.94 · held-out slope R² ≈ 0.999
            gating 347 / 347 met`"]
            TA -->|"σ² transfers ≈ 0.94–0.96"| EB
        end
        subgraph GEN["Genetic modality · CRISPRi Perturb-seq"]
            direction TB
            OR["`**X-Atlas/Orion · cross-modality transfer**
            genome-wide CRISPRi · ~8M cells
            18,903 knockdowns × 2 lines
            σ² = 0.91 / 1.03 · median m 0.14–0.35
            0% over-sampled (magnitude-limited)`"]
            TR["`**TRADE · validated genetic falsification**
            essential-gene CRISPRi · Jurkat + HepG2
            2,393 genes/line · slope 1.02 / 0.96 · R² = 0.996
            median 45–85 cells/gene → depth-limited`"]
            OR -->|"direct falsification"| TR
        end
    end

    HUB("`**One threshold n★, two ledgers**`")

    subgraph OUT["Downstream Value"]
        direction LR
        WET("`**Wet-lab**
        magnitude-adaptive budgeting
        ~3.1× fewer cells · triage / multiplex`")
        DRY("`**Dry-lab**
        provably-safe downsampling
        triage of low-SNR similarity edges`")
    end

    Q --> TH
    TH -->|"proven"| PROOF
    PROOF --> PIPE
    PIPE --> TA
    PIPE --> OR
    EB --> HUB
    TR --> HUB
    HUB --> WET
    HUB --> DRY

    %% high-contrast: white fills, thick semantic strokes, dark charcoal text
    classDef question fill:#FFFFFF,stroke:#334155,stroke-width:2px,color:#0F172A;
    classDef theory fill:#FFFFFF,stroke:#334155,stroke-width:2px,color:#0F172A;
    classDef proof fill:#FFFFFF,stroke:#334155,stroke-width:2px,color:#0F172A;
    classDef engine fill:#FFFFFF,stroke:#16A34A,stroke-width:2px,color:#0F172A;
    classDef chem fill:#FFFFFF,stroke:#2563EB,stroke-width:2px,color:#0F172A;
    classDef gen fill:#FFFFFF,stroke:#16A34A,stroke-width:2px,color:#0F172A;
    classDef hub fill:#FFFFFF,stroke:#334155,stroke-width:2.5px,color:#0F172A;
    classDef wet fill:#FFFFFF,stroke:#334155,stroke-width:2px,color:#0F172A;
    classDef dry fill:#FFFFFF,stroke:#334155,stroke-width:2px,color:#0F172A;

    class Q question;
    class TH theory;
    class P1,P2,P3,P4 proof;
    class PIPE engine;
    class TA,EB chem;
    class OR,TR gen;
    class HUB hub;
    class WET wet;
    class DRY dry;

    style PROOF fill:#FFFFFF,stroke:#94A3B8,stroke-width:1.4px,color:#0F172A;
    style EMP fill:transparent,stroke:#94A3B8,stroke-width:1.5px,stroke-dasharray:6 4,color:#0F172A;
    style CHEM fill:#EFF6FF,stroke:#2563EB,stroke-width:1.5px,color:#0F172A;
    style GEN fill:#F0FDF4,stroke:#16A34A,stroke-width:1.5px,color:#0F172A;
    style OUT fill:#FFFFFF,stroke:#94A3B8,stroke-width:1.4px,color:#0F172A;
