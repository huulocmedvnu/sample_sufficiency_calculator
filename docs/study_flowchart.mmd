%% Study overview flowchart (Mermaid.js source, for web / GitHub rendering).
%% The manuscript embeds a Graphviz render of the same design
%% (scripts/make_study_flowchart.py -> figures/fig1_study_flowchart.pdf), because the
%% pandoc/tectonic PDF build has no Mermaid renderer. Keep the two in sync by hand.
%%{init: {'theme':'base','themeVariables':{'fontFamily':'Inter, Segoe UI, Helvetica, sans-serif','fontSize':'13px','lineColor':'#64748B'},'flowchart':{'curve':'basis','nodeSpacing':45,'rankSpacing':55,'padding':8}}}%%
graph TD
    Q(["`**Core research question**
    How many cells resolve a perturbation's *direction* to tolerance θ?`"])

    TH("`**Closed-form cell quota**
    n★ = 2·tr(PΣP) / (m²θ²)
    calibrated → n★ ≈ 9,376 / m²`")

    subgraph PROOF["Airtight foundation · proven four independent ways"]
        direction LR
        P1("`**Independent impl.**`")
        P2("`**Monte-Carlo**`")
        P3("`**SymPy**`")
        P4("`**Lean 4 / Mathlib**`")
    end

    PIPE("`**Shared embedding engine**
    Estimates within-condition σ²`")

    subgraph EMP["Cross-Modality Empirical Validation"]
        direction LR
        subgraph CHEM["Chemical modality"]
            direction TB
            TA["`**Tahoe-100M**
            σ² = 0.96
            in-regime slope 0.94 · R² ≈ 0.999`"]
            EB["`**EmeraldBay**
            σ² ≈ 0.94
            held-out slope 0.98 · R² ≈ 0.999`"]
            TA -->|"σ² transfers ≈ 0.94–0.96"| EB
        end
        subgraph GEN["Genetic modality"]
            direction TB
            OR["`**X-Atlas/Orion**
            σ² = 0.91 / 1.03
            n★ ≈ 9,000 / m² · σ² transfers`"]
            TR["`**TRADE**
            σ² = 1.5 / 1.9
            slope 1.02 / 0.96 · R² = 0.996`"]
            OR -->|"direct falsification"| TR
        end
    end

    Q --> TH
    TH -->|"proven"| PROOF
    PROOF --> PIPE
    PIPE -->|"calibrate"| TA
    PIPE -->|"transfer"| OR

    %% high-contrast: white fills, thin semantic strokes, dark charcoal text
    classDef question fill:#FFFFFF,stroke:#334155,stroke-width:1.5px,color:#0F172A;
    classDef theory fill:#FFFFFF,stroke:#334155,stroke-width:1.5px,color:#0F172A;
    classDef proof fill:#FFFFFF,stroke:#334155,stroke-width:1.5px,color:#0F172A;
    classDef engine fill:#FFFFFF,stroke:#065F46,stroke-width:1.5px,color:#0F172A;
    classDef chem fill:#FFFFFF,stroke:#1E40AF,stroke-width:1.5px,color:#0F172A;
    classDef gen fill:#FFFFFF,stroke:#065F46,stroke-width:1.5px,color:#0F172A;

    class Q question;
    class TH theory;
    class P1,P2,P3,P4 proof;
    class PIPE engine;
    class TA,EB chem;
    class OR,TR gen;

    %% borderless, transparent containers — label-only headers
    style PROOF fill:transparent,stroke:transparent,color:#0F172A;
    style EMP fill:transparent,stroke:transparent,color:#0F172A;
    style CHEM fill:transparent,stroke:transparent,color:#0F172A;
    style GEN fill:transparent,stroke:transparent,color:#0F172A;
